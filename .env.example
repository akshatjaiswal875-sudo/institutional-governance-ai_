NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional semantic embeddings only. The app's normal Search and Assistant work without OpenAI.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gmail SMTP for meeting invitations (no custom domain required for testing)
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-16-character-google-app-password

# Public URL used in invitation and reminder links. Set this to the deployed Vercel domain in Production.
NEXT_PUBLIC_SITE_URL=https://institutional-governance-ai.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini is the default AI provider when configured; Hugging Face is the automatic fallback.
# Use a model available to your Google AI Studio API key.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: set to 'gemini' or 'huggingface'. Defaults to Gemini when GEMINI_API_KEY exists.
AI_PRIMARY_PROVIDER=gemini

# Optional hosted AI-analysis fallback. Whisper transcription uses the self-hosted worker below.
HUGGINGFACE_API_KEY=your-huggingface-token
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
HUGGINGFACE_SUMMARY_MODEL=openai/gpt-oss-120b:fastest
HUGGINGFACE_ANSWER_MODEL=openai/gpt-oss-120b:fastest

# Self-hosted, no-inference-fee Whisper worker.
# Set the worker's public URL ending in /transcribe and the same random token on both services.
WHISPER_WORKER_URL=
WHISPER_WORKER_TOKEN=
